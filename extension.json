{
	"name": "Page Approvals",

	"version": "2.0.0-alpha",

	"author": [
		"[https://Professional.Wiki/ Professional.Wiki]"
	],

	"license-name": "BSD-3-Clause",

	"url": "https://professional.wiki/en/extension/page-approvals",

	"descriptionmsg": "pageapprovals-description",

	"requires": {
		"MediaWiki": ">= 1.43.0"
	},

	"MessagesDirs": {
		"PageApprovals": [
			"i18n"
		]
	},

	"AutoloadNamespaces": {
		"ProfessionalWiki\\PageApprovals\\": "src/",
		"ProfessionalWiki\\PageApprovals\\Tests\\": "tests/"
	},

	"SpecialPages": {
		"ManageApprovers": {
			"class": "ProfessionalWiki\\PageApprovals\\EntryPoints\\Specials\\SpecialManageApprovers",
			"factory": "ProfessionalWiki\\PageApprovals\\PageApprovals::newSpecialManageApprovers"
		},
		"PendingApprovals": {
			"class": "ProfessionalWiki\\PageApprovals\\EntryPoints\\Specials\\SpecialPendingApprovals",
			"factory": "ProfessionalWiki\\PageApprovals\\PageApprovals::newSpecialPendingApprovals"
		}
	},

	"ExtensionMessagesFiles": {
		"PageApprovalsAlias": "i18n/Aliases/Aliases.php"
	},

	"AvailableRights": [
		"manage-approvers"
	],
	"GroupPermissions": {
		"*": {
			"manage-approvers": false
		},
		"sysop": {
			"manage-approvers": true
		}
	},

	"Hooks": {
		"OutputPageParserOutput": "ProfessionalWiki\\PageApprovals\\EntryPoints\\PageApprovalsHooks::onOutputPageParserOutput",
		"LoadExtensionSchemaUpdates": "ProfessionalWiki\\PageApprovals\\EntryPoints\\PageApprovalsHooks::onLoadExtensionSchemaUpdates",
		"OutputPageBeforeHTML": "ProfessionalWiki\\PageApprovals\\EntryPoints\\PageApprovalsHooks::onOutputPageBeforeHTML"
	},

	"config": {
	},

	"ResourceFileModulePaths": {
		"localBasePath": "resources",
		"remoteExtPath": "PageApprovals/resources"
	},

	"ResourceModules": {
		"ext.pageApprovals": {
			"class": "MediaWiki\\ResourceLoader\\CodexModule",
			"packageFiles": [
				"ext.pageApprovals/init.js",
				"ext.pageApprovals/utils/api.js",
				"ext.pageApprovals/utils/time.js",
				"ext.pageApprovals/components/App.vue",
				"ext.pageApprovals/components/ApprovalButton.vue",
				"ext.pageApprovals/components/StatusDisplay.vue",
				{
					"name": "ext.pageApprovals/icons.json",
					"callback": "MediaWiki\\ResourceLoader\\CodexModule::getIcons",
					"callbackParam": [
						"cdxIconCollapse",
						"cdxIconExpand",
						"cdxIconCheck",
						"cdxIconClose"
					]
				}
			],
			"skinStyles": {
				"vector-2022": [
					"ext.pageApprovals/styles/ext.pageApprovals.vector-2022.less"
				]
			},
			"codexComponents": [
				"CdxMenuButton",
				"CdxIcon",
				"CdxInfoChip",
				"CdxTooltip"
			],
			"dependencies": [
				"vue",
				"mediawiki.api",
				"mediawiki.notification"
			],
			"messages": [
				"pageapprovals-status-approved",
				"pageapprovals-status-not-approved",
				"pageapprovals-approve-page-text",
				"pageapprovals-approve-button",
				"pageapprovals-unapprove-button",
				"pageapprovals-approved",
				"pageapprovals-unapproved"
			]
		},
		"ext.pageApprovals.manageApprovers": {
			"class": "MediaWiki\\ResourceLoader\\CodexModule",
			"packageFiles": [
				"ext.pageApprovals/manageApprovers/init.js",
				"ext.pageApprovals/manageApprovers/components/ManageApproversApp.vue",
				{
					"name": "ext.pageApprovals/manageApprovers/icons.json",
					"callback": "MediaWiki\\ResourceLoader\\CodexModule::getIcons",
					"callbackParam": [
						"cdxIconEdit",
						"cdxIconTrash",
						"cdxIconClose",
						"cdxIconUserGroup"
					]
				}
			],
			"styles": [
				"ext.pageApprovals/styles/manageApprovers.less"
			],
			"version": "2.0.1",
			"codexComponents": [
				"CdxButton",
				"CdxTextInput", 
				"CdxField",
				"CdxTable",
				"CdxLookup",
				"CdxMultiselectLookup",
				"CdxIcon",
				"CdxDialog"
			],
			"dependencies": [
				"vue",
				"mediawiki.api",
				"mediawiki.notification",
				"mediawiki.util"
			],
			"messages": [
				"manageapprovers",
				"pageapprovals-add-approver",
				"pageapprovals-username",
				"pageapprovals-categories",
				"pageapprovals-add-category",
				"pageapprovals-delete",
				"pageapprovals-add",
				"pageapprovals-error-adding-approver",
				"pageapprovals-error-adding-category",
				"pageapprovals-error-deleting-category",
				"pageapprovals-loading",
				"pageapprovals-invalid-username",
				"pageapprovals-invalid-category",
				"pageapprovals-actions",
				"pageapprovals-remove-approver",
				"pageapprovals-confirm-remove-approver",
				"pageapprovals-approver-removed",
				"pageapprovals-error-removing-approver",
				"pageapprovals-no-categories-assigned",
				"pageapprovals-edit-categories",
				"pageapprovals-close-edit-dialog",
				"pageapprovals-edit-categories-for",
				"pageapprovals-current-categories",
				"pageapprovals-add-categories",
				"pageapprovals-close",
				"pageapprovals-search-add-category",
				"pageapprovals-remove-category",
				"pageapprovals-category-already-added",
				"pageapprovals-save-changes",
				"pageapprovals-saving",
				"pageapprovals-categories-saved",
				"pageapprovals-error-saving-categories"
			]
		},
		"ext.pageApprovals.pendingApprovals": {
			"class": "MediaWiki\\ResourceLoader\\CodexModule",
			"packageFiles": [
				"ext.pageApprovals/pendingApprovals/init.js",
				"ext.pageApprovals/pendingApprovals/components/PendingApprovalsApp.vue"
			],
			"codexComponents": [
				"CdxTable",
				"CdxButton"
			],
			"dependencies": [
				"vue",
				"mediawiki.api",
				"mediawiki.notification",
				"mediawiki.util"
			],
			"messages": [
				"pendingapprovals",
				"pageapprovals-pending-approvals-page",
				"pageapprovals-pending-approvals-categories", 
				"pageapprovals-pending-approvals-last-edit-time",
				"pageapprovals-pending-approvals-last-edit-by",
				"pageapprovals-no-pending-approvals",
				"pageapprovals-loading",
				"pageapprovals-actions",
				"pageapprovals-approve-button",
				"pageapprovals-approved",
				"pageapprovals-approve-authorization-failed"
			]
		}
	},

	"RestRoutes": [
		{
			"path": "/page-approvals/v0/revision/{revisionId}/approve",
			"method": [ "POST" ],
			"factory": "ProfessionalWiki\\PageApprovals\\PageApprovals::newApprovePageApi"
		},
		{
			"path": "/page-approvals/v0/revision/{revisionId}/unapprove",
			"method": [ "POST" ],
			"factory": "ProfessionalWiki\\PageApprovals\\PageApprovals::newUnapprovePageApi"
		},
		{
			"path": "/page-approvals/v0/approvers",
			"method": [ "GET" ],
			"factory": "ProfessionalWiki\\PageApprovals\\PageApprovals::newGetApproversApi"
		},
		{
			"path": "/page-approvals/v0/approvers",
			"method": [ "POST" ],
			"factory": "ProfessionalWiki\\PageApprovals\\PageApprovals::newManageApproverApi"
		},
		{
			"path": "/page-approvals/v0/pending-approvals",
			"method": [ "GET" ],
			"factory": "ProfessionalWiki\\PageApprovals\\PageApprovals::newGetPendingApprovalsApi"
		}
	],

	"manifest_version": 2
}
